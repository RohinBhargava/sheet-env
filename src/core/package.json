{
  "name": "@sheet-env/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core library for sheet-env, containing shared foundational infrastrucuture and utilities",
  "keywords": [],
  "license": "none",
  "author": "ForkLaunch",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist lib pnpm.lock.yaml tsconfig.tsbuildinfo node_modules",
    "docs": "typedoc --out docs *",
    "format": "prettier --ignore-path=.prettierignore --config .prettierrc '**/*.{ts,tsx,json}' --write",
    "lint": "oxlint --config .oxlint.config.json",
    "lint:fix": "oxlint --fix --config .oxlint.config.json",
    "test": "pnpm vitest --passWithNoTests"
  },
  "dependencies": {
    "@forklaunch/common": "~1.2.32",
    "@forklaunch/core": "~3.4.0",
    "@forklaunch/express": "~1.2.53",
    "@forklaunch/validator": "~1.3.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/qs": "^6.15.1",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.8",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0"
  },
  "mikro-orm": {
    "manifest_paths": [
      "./mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  }
}