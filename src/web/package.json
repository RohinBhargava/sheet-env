{
  "name": "@sheet-env/web",
  "version": "0.0.1",
  "private": true,
  "description": "ForkLaunch Sheets browser app, served by the workbooks service from workbooks/web-dist",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5491",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5491",
    "typecheck": "tsc --noEmit",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "check-tasks": "node --disable-warning=ExperimentalWarning scripts/check-tasks.ts",
    "mock-api": "node dev/mock-api.mjs",
    "e2e": "node --disable-warning=ExperimentalWarning dev/e2e.mjs",
    "solve": "node --disable-warning=ExperimentalWarning scripts/solve.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
