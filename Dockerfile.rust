# Generated shared Rust image. Run cargo generate-lockfile before the first image build.
FROM rust:1.98.0-slim-bookworm AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev libcurl4-openssl-dev ca-certificates cmake make g++ perl && rm -rf /var/lib/apt/lists/*
COPY [".cargo/config.toml","/app/.cargo/config.toml"]
COPY [".forklaunch/manifest.toml","/app/.forklaunch/manifest.toml"]
COPY ["Cargo.lock","/app/Cargo.lock"]
COPY ["Cargo.toml","/app/Cargo.toml"]
COPY ["src/client-sdk/","/app/src/client-sdk/"]
COPY ["src/workbooks/","/app/src/workbooks/"]
ENV SQLX_OFFLINE=true
ARG CARGO_BUILD_JOBS=2
RUN cargo build --locked --release --workspace --bins
FROM debian:bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
ADD --chmod=0644 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /app/certs/rds-global-bundle.pem
RUN chmod 0755 /app/certs
COPY --from=builder /app/target/release/workbooks /app/bin/workbooks
ENV HOST=0.0.0.0 PROTOCOL=http PORT=8000 VERSION=v1 DOCS_PATH=/docs
USER 65532:65532
